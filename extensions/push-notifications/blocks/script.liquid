{% schema %}
{
  "name": "Push_Notifications",
  "target": "body",
  "settings": []
}
{% endschema %}

<!-- Push Notification Modal -->
<div id="push-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;justify-content:center;align-items:center;z-index:9999;">
  <div id="push-modal-card" style="position:relative;padding:20px;box-shadow:0 6px 18px rgba(0,0,0,0.08);font-family:sans-serif;">
    <button id="push-close-btn" style="position:absolute;top:12px;right:12px;border:none;background:transparent;font-size:18px;font-weight:bold;cursor:pointer;">×</button>
    <img id="push-modal-image" style="display:none;width:100%;border-radius:8px;margin-bottom:12px;"/>
    <div id="push-modal-text" style="color:#111;">
      <div id="push-modal-title" style="font-size:16px;font-weight:600;">Stay updated!</div>
      <div id="push-modal-body" style="margin-top:6px;font-size:14px;color:#555;opacity:0.9;">Allow notifications to get the latest offers.</div>
    </div>
    <div style="display:flex;gap:10px;margin-top:14px;">
      <button id="push-allow-btn" style="flex:1;padding:10px 12px;font-weight:600;cursor:pointer;">Allow</button>
      <button id="push-deny-btn" style="flex:1;padding:10px 12px;border:1px solid rgba(0,0,0,0.08);cursor:pointer;">Not now</button>
    </div>
  </div>
</div>

<script>
(async function () {
  const DEBUG = true;
  const debug = (...args) => DEBUG && console.log('[PUSH DEBUG]', ...args);

  const firebaseModuleUrl = 'https://www.gstatic.com/firebasejs/12.0.0';
  const firebaseConfig = {
    apiKey: "AIzaSyDlAIWrQeYfui2kO1CulpTeMz8FB7hT_2s",
    authDomain: "push-notify-2025.firebaseapp.com",
    projectId: "push-notify-2025",
    storageBucket: "push-notify-2025.firebasestorage.app",
    messagingSenderId: "666851901382",
    appId: "1:666851901382:web:3e159468bc36d128dafcc7",
    measurementId: "G-0X2W8S4QZE"
  };
  const vapidKey = 'BF-c9w6XoYxZULl_rXymLo6DaFTIWR33j7WulhbLtTovV80m1ptMztGNtxLqqw1SokHR1ZQRF3xCEMBLnNaBbw0';


  const shop = window.Shopify?.shop || window.location.hostname;

  // === Generate or Get Session ID ===
  function getOrCreateVisitorId() {
    let visitorId = localStorage.getItem('push_visitor_id');
    if (!visitorId) {
      visitorId = `visitor_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
      localStorage.setItem('push_visitor_id', visitorId);
      debug('Created new visitor ID:', visitorId);
    } else {
      debug('Existing visitor ID:', visitorId);
    }
    return visitorId;
  }
  const sessionId = getOrCreateVisitorId();

  // === Utility Functions ===
  async function fetchCustomUI(shopDomain) {
    try {
      const res = await fetch(`https://api.zingbot.io/push-notify/push-notify/customui.php?shop_domain=${shopDomain}`);
      return await res.json();
    } catch (err) {
      debug('fetchCustomUI failed:', err);
      return null;
    }
  }

  function getBrowserInfo() {
    const ua = navigator.userAgent;
    let browser = "Unknown", version = "Unknown";
    if (/Edg\//.test(ua)) { browser = "Edge"; version = ua.match(/Edg\/([\d.]+)/)?.[1]; }
    else if (/OPR\//.test(ua)) { browser = "Opera"; version = ua.match(/OPR\/([\d.]+)/)?.[1]; }
    else if (/Chrome\//.test(ua)) { browser = "Chrome"; version = ua.match(/Chrome\/([\d.]+)/)?.[1]; }
    else if (/Safari\//.test(ua) && !/Chrome\//.test(ua)) { browser = "Safari"; version = ua.match(/Version\/([\d.]+)/)?.[1]; }
    else if (/Firefox\//.test(ua)) { browser = "Firefox"; version = ua.match(/Firefox\/([\d.]+)/)?.[1]; }

    let os = "Unknown";
    if (/Windows NT/.test(ua)) os = "Windows";
    else if (/Mac OS X/.test(ua)) os = "MacOS";
    else if (/Android/.test(ua)) os = "Android";
    else if (/iPhone|iPad|iPod/.test(ua)) os = "iOS";
    else if (/Linux/.test(ua)) os = "Linux";

    return { browser, version, os, ua };
  }

  async function getVisitorLocation() {
    try {
      const res = await fetch('https://ipapi.co/json/');
      const geo = await res.json();
      return { ip: geo.ip, geo };
    } catch {
      return { ip: null, geo: {} };
    }
  }

  async function fetchCartSafe() {
    try {
      const res = await fetch('/cart.js');
      if (!res.ok) throw new Error('cart.js returned ' + res.status);
      return await res.json();
    } catch {
      return { token: null, items: [] };
    }
  }

  async function sendToServer(payload) {
    try {
      debug('Sending to server:', payload);
      await fetch('https://api.zingbot.io/push-notify/push-notify/save_token_client.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      debug('Data sent successfully');
    } catch (err) {
      debug('sendToServer failed:', err);
    }
  }

  // === Step 1: Initial Visit Data ===
  async function sendInitialVisitorData() {
    debug('=== SENDING INITIAL VISITOR DATA ===');
    const { ip, geo } = await getVisitorLocation();
    const browserInfo = getBrowserInfo();
    const cart = await fetchCartSafe();

    const payload = {
      session_id: sessionId,
      shop: shop,
      ip_add: ip,
      location: {
        country: geo?.country_name ?? null,
        state: geo?.region ?? null,
        city: geo?.city ?? null
      },
      browser: browserInfo,
      cart_token: cart?.token ?? null,
      cart_items: cart?.items ?? [],
      url: window.location.href,
      fcm_token: null,
      visit_timestamp: (new Date()).toISOString(),
      is_initial_visit: true
    };

    await sendToServer(payload);
  }

  // === Step 2: Register SW & FCM Token ===
  async function tryRegisterSWAndGetToken() {
    try {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        debug('Notification permission denied');
        return null;
      }

      const appModule = await import(`${firebaseModuleUrl}/firebase-app.js`);
      const msgModule = await import(`${firebaseModuleUrl}/firebase-messaging.js`);
      const app = appModule.initializeApp(firebaseConfig);
      const messaging = msgModule.getMessaging(app);

      if (!('serviceWorker' in navigator)) return null;

      const registration = await navigator.serviceWorker.register('/apps/notify/firebase-messaging-sw.js');
      await new Promise(r => setTimeout(r, 400));
      const token = await msgModule.getToken(messaging, { vapidKey, serviceWorkerRegistration: registration });
      if (token) {
        debug('FCM token obtained:', token);
        return token;
      }
      return null;
    } catch (err) {
      debug('tryRegisterSWAndGetToken failed:', err);
      return null;
    }
  }

  // === Step 3: Cart Tracking (Live Updates) ===
  async function sendUpdatedCart() {
    try {
      const cart = await fetchCartSafe();
      const payload = {
        session_id: sessionId,
        shop: shop,
        cart_token: cart?.token ?? null,
        cart_items: cart?.items ?? [],
        url: window.location.href,
        cart_updated: true,
        timestamp: new Date().toISOString()
      };
      await sendToServer(payload);
      debug('Cart updated data sent');
    } catch (err) {
      debug('Cart update send failed:', err);
    }
  }

  // Intercept fetch to detect cart changes
  const originalFetch = window.fetch;
  window.fetch = async function (...args) {
    const response = await originalFetch.apply(this, args);
    const url = (args[0] && args[0].toString()) || '';
    if (url.includes('/cart/add') || url.includes('/cart/update') || url.includes('/cart/change')) {
      debug('Detected cart update via fetch:', url);
      setTimeout(sendUpdatedCart, 1000);
    }
    return response;
  };

  // === Step 4: UI + Modal Setup ===
  function applyUI(ui) {
    if (!ui) return;
    const card = document.getElementById('push-modal-card');
    card.style.background = ui.colors.card;
    card.style.fontFamily = ui.font;

    document.getElementById('push-modal-title').textContent = ui.title;
    document.getElementById('push-modal-body').textContent = ui.body;

    const img = document.getElementById('push-modal-image');
    if (ui.image) { img.src = ui.image; img.style.display = 'block'; }

    const allowBtn = document.getElementById('push-allow-btn');
    allowBtn.textContent = ui.buttons.primary.text;
    allowBtn.style.background = ui.buttons.primary.color;
    allowBtn.style.borderRadius = ui.buttonShape === 'rounded' ? '8px' : '2px';

    const denyBtn = document.getElementById('push-deny-btn');
    denyBtn.textContent = ui.buttons.secondary.text;
    denyBtn.style.color = ui.buttons.secondary.color;
    denyBtn.style.borderColor = ui.buttons.secondary.color;
    denyBtn.style.borderRadius = ui.buttonShape === 'rounded' ? '8px' : '2px';
  }

  function setupPushModal() {
    const modal = document.getElementById('push-modal');
    modal.style.display = 'flex';

    const hideModal = () => {
      localStorage.setItem('push_permission_set', 'true');
      modal.style.display = 'none';
    };

    document.getElementById('push-deny-btn')?.addEventListener('click', hideModal);
    document.getElementById('push-close-btn')?.addEventListener('click', hideModal);

    document.getElementById('push-allow-btn')?.addEventListener('click', async () => {
      hideModal();
      debug('=== USER CLICKED ALLOW - GETTING FCM TOKEN ===');

      const token = await tryRegisterSWAndGetToken();
      if (token) {
        const payload = {
          session_id: sessionId,
          shop: shop,
          fcm_token: token,
          token_timestamp: new Date().toISOString(),
          is_token_update: true
        };
        await sendToServer(payload);
        debug('FCM token linked to session');
      } else {
        debug('Failed to get FCM token');
      }
    });
  }

  // === Init ===
debug('=== SCRIPT STARTED ===');
await sendInitialVisitorData();
const ui = await fetchCustomUI(shop);
const delay = (ui?.delay ?? 5) * 1000;
applyUI(ui);

// ✔ AUTO Native permission request (works everywhere)
tryRegisterSWAndGetToken()
  .then(async (token) => {
    console.log("Native permission triggered automatically");
    if (token) {
      const payload = {
        session_id: sessionId,
        shop: shop,
        fcm_token: token,
        token_timestamp: new Date().toISOString(),
        is_token_update: true
      };
      await sendToServer(payload);
      debug('FCM token sent from native trigger');
    }
  })
  .catch(() => {});

setTimeout(() => {
  const showPush = new URLSearchParams(window.location.search).get('show_push');

  if (showPush === '1') {
    setupPushModal();
  } else {
    console.log("Push modal disabled because show_push != 1");
  }

}, delay);


})();

</script>
