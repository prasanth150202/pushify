
{% schema %}
{
  "name": "Push_Notifications",
  "target": "body",
  "settings": []
}
{% endschema %}

<!-- Push Notification Modal -->
<div id="push-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.2);justify-content:center;align-items:center;z-index:9999;">
  <div id="push-modal-card" style="position:relative;background:#f7f7f7;border-radius:12px;padding:20px;width:360px;box-shadow:0 6px 18px rgba(0,0,0,0.08);font-family:sans-serif;">
    
    <!-- Close Button -->
    <button
      id="push-close-btn"
      style="position:absolute;top:12px;right:12px;border:none;background:transparent;font-size:18px;font-weight:bold;cursor:pointer;color:#999;"
    >
      ×
    </button>

    <!-- Image -->
    <img id="push-modal-image" style="display:none;width:100%;border-radius:8px;margin-bottom:12px;" />

    <!-- Content -->
    <div style="color:#111;">
      <div id="push-modal-title" style="font-size:16px;font-weight:600;">Stay updated!</div>
      <div id="push-modal-body" style="margin-top:6px;font-size:14px;color:#555;opacity:0.9;">Allow notifications to get the latest offers.</div>
    </div>

    <!-- Buttons -->
    <div style="display:flex;gap:10px;margin-top:14px;">
      <button id="push-allow-btn" style="flex:1;padding:10px 12px;border-radius:8px;border:none;background:#0066ff;color:white;font-weight:600;cursor:pointer;">Allow</button>
      <button id="push-deny-btn" style="flex:1;padding:10px 12px;border-radius:8px;border:1px solid rgba(0,0,0,0.08);background:transparent;color:#777;cursor:pointer;">Not now</button>
    </div>

   
  </div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";
import { getMessaging, getToken } from "https://www.gstatic.com/firebasejs/12.0.0/firebase-messaging.js";

// Firebase config
const firebaseConfig = {
  apiKey: "AIzaSyDlAIWrQeYfui2kO1CulpTeMz8FB7hT_2s",
  authDomain: "push-notify-2025.firebaseapp.com",
  projectId: "push-notify-2025",
  storageBucket: "push-notify-2025.firebasestorage.app",
  messagingSenderId: "666851901382",
  appId: "1:666851901382:web:3e159468bc36d128dafcc7",
  measurementId: "G-0X2W8S4QZE"
};
const app = initializeApp(firebaseConfig);
const messaging = getMessaging(app);

// Config
const config = {
  title: "Stay updated!",
  body: "Allow notifications to get the latest offers.",
  image: "", // optional
  colors: {
    card: "#f7f7f7",
    text: "#111111",
    primary: "#0066ff",
    secondary: "#777777"
  },
  buttons: {
    primaryText: "Allow",
    secondaryText: "Not now"
  },
  delay: 5 // seconds
};

// Setup modal
function setupPushModal() {
  const modal = document.getElementById('push-modal');
  const modalCard = document.getElementById('push-modal-card');
  const modalTitle = document.getElementById('push-modal-title');
  const modalBody = document.getElementById('push-modal-body');
  const modalImage = document.getElementById('push-modal-image');
  const allowBtn = document.getElementById('push-allow-btn');
  const denyBtn = document.getElementById('push-deny-btn');
  const closeBtn = document.getElementById('push-close-btn');

  modalCard.style.background = config.colors.card;
  modalTitle.textContent = config.title;
  modalTitle.style.color = config.colors.text;
  modalBody.textContent = config.body;

  allowBtn.style.background = config.colors.primary;
  allowBtn.textContent = config.buttons.primaryText;
  denyBtn.style.color = config.colors.secondary;
  denyBtn.textContent = config.buttons.secondaryText;

  if (config.image) {
    modalImage.src = config.image;
    modalImage.style.display = 'block';
  }

  modal.style.display = 'flex';

  // Allow
  allowBtn.addEventListener('click', async () => {
    const token = await registerServiceWorkerAndGetToken();
    localStorage.setItem('push_permission_set', 'true');
    modal.style.display = 'none';

    if (token) {
      try {
        const res = await fetch('/cart.js');
        const cart = await res.json();
        await fetch('https://api.zingbot.io/push-notify/save_token_client.php', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({
            shop: Shopify.shop,
            token,
            cart_token: cart?.token ?? null,
            cart_items: cart?.items ?? [],
            url: window.location.href
          })
        });
      } catch (err) {
        console.error('Failed to save token:', err);
      }
    }
  });

  // Deny
  denyBtn.addEventListener('click', () => {
    localStorage.setItem('push_permission_set', 'true');
    modal.style.display = 'none';
  });

  // Close button
  closeBtn.addEventListener('click', () => {
    localStorage.setItem('push_permission_set', 'true');
    modal.style.display = 'none';
  });
}

// Firebase token
async function registerServiceWorkerAndGetToken() {
  try {
    const registration = await navigator.serviceWorker.register('/apps/notify/firebase-messaging-sw.js');
    const token = await getToken(messaging, {
      vapidKey: 'BF-c9w6XoYxZULl_rXymLo6DaFTIWR33j7WulhbLtTovV80m1ptMztGNtxLqqw1SokHR1ZQRF3xCEMBLnNaBbw0',
      serviceWorkerRegistration: registration
    });
    return token;
  } catch (err) {
    console.error('Push registration error:', err);
    return null;
  }
}

// Delay
setTimeout(() => {
  if (!localStorage.getItem('push_permission_set')) {
    setupPushModal();
  }
}, config.delay * 1000);
</script>

<script>
async function printVisitorLocation() {
  try {
    // Step 1: Get client IP
    const ipRes = await fetch('https://api.ipify.org?format=json');
    const { ip } = await ipRes.json();

    // Step 2: Get location info from IP
    const geoRes = await fetch(`https://ipapi.co/${ip}/json/`);
    const geo = await geoRes.json();

    console.log("Visitor IP:", ip);
    console.log("Region/State:", geo.region);    // Example: "Tamil Nadu"
    console.log("City:", geo.city);
    console.log("Country:", geo.country_name);
    console.log("Full Geo Object:", geo);       // Optional: see all fields
  } catch (err) {
    console.error("Failed to get visitor location:", err);
  }
}

// Call it
printVisitorLocation();


</script>
<script>
function getBrowserInfo() {
  const ua = navigator.userAgent || navigator.vendor || window.opera;
  let browser = "Unknown";
  let version = "Unknown";

  if (/Edg\//.test(ua)) {
    browser = "Edge";
    version = ua.match(/Edg\/([\d.]+)/)?.[1];
  } else if (/OPR\//.test(ua)) {
    browser = "Opera";
    version = ua.match(/OPR\/([\d.]+)/)?.[1];
  } else if (/Brave/.test(navigator.userAgentData?.brands?.map(b => b.brand).join(" "))) {
    browser = "Brave";
  } else if (/Brave/.test(ua)) {
    browser = "Brave";
  } else if (/Chrome\//.test(ua)) {
    browser = "Chrome";
    version = ua.match(/Chrome\/([\d.]+)/)?.[1];
  } else if (/Safari\//.test(ua) && !/Chrome\//.test(ua)) {
    browser = "Safari";
    version = ua.match(/Version\/([\d.]+)/)?.[1];
  } else if (/Firefox\//.test(ua)) {
    browser = "Firefox";
    version = ua.match(/Firefox\/([\d.]+)/)?.[1];
  }

  let os = "Unknown";
  if (/Windows NT/.test(ua)) os = "Windows";
  else if (/Mac OS X/.test(ua)) os = "MacOS";
  else if (/Android/.test(ua)) os = "Android";
  else if (/iPhone|iPad|iPod/.test(ua)) os = "iOS";
  else if (/Linux/.test(ua)) os = "Linux";

  return { browser, version, os };
}

// Call it
console.log("Browser Info:", getBrowserInfo());
</script>
